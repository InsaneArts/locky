-- Locky's config. Lua, like Neovim's init.lua. Locky runs it each time the screen locks.
-- Check it with `locky check`; read the log in Settings › Lua Config.

locky.setup({
  -- A theme from `locky themes`, or one of your own in themes/<name>.lua next to this file.
  theme = "default",

  -- Override any theme's colors, background, or widget options:
  -- palette = { accent = "#ff79c6" },
  -- background = { wallpaper = true, blur = 30, dim = 0.3 },
  -- widgets = { clock = { format = "HH:mm" } },
})

